@{
    ViewData["Title"] = "Actividades para Mujeres";
}

<div class="container">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-4">?? Actividades para Mujeres</h1>
            <p class="lead">Explora actividades diseñadas específicamente para mujeres</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 border-danger shadow">
                <div class="card-header bg-danger text-white">
                    <h4>?? Danza y Expresión</h4>
                </div>
                <div class="card-body">
                    <p>Explora diferentes estilos de danza y expresión corporal</p>
                    <ul class="list-unstyled">
                        <li>?? Ballet básico</li>
                        <li>?? Danza contemporánea</li>
                        <li>?? Expresión corporal</li>
                    </ul>
                </div>
                <div class="card-footer">
                    <a href="#" class="btn btn-danger w-100">Proximamente</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-danger shadow">
                <div class="card-header bg-danger text-white">
                    <h4>????? Yoga y Bienestar</h4>
                </div>
                <div class="card-body">
                    <p>Sesiones de yoga y bienestar diseñadas para mujeres</p>
                    <ul class="list-unstyled">
                        <li>?? Yoga restaurativo</li>
                        <li>????? Meditación guiada</li>
                        <li>? Técnicas de autocuidado</li>
                    </ul>
                </div>
                <div class="card-footer">
                    <a href="#" class="btn btn-danger w-100">Proximamente</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-danger shadow">
                <div class="card-header bg-danger text-white">
                    <h4>?? Círculos de Apoyo</h4>
                </div>
                <div class="card-body">
                    <p>Espacios seguros para compartir experiencias y apoyarse mutuamente</p>
                    <ul class="list-unstyled">
                        <li>?? Charlas sobre desarrollo personal</li>
                        <li>?? Club de lectura femenino</li>
                        <li>?? Mentorías entre mujeres</li>
                    </ul>
                </div>
                <div class="card-footer">
                    <a href="#" class="btn btn-danger w-100">Proximamente</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12 text-center">
            <a asp-action="Index" class="btn btn-outline-secondary">Volver a todas las actividades</a>
        </div>
    </div>
</div>